{
  "expo": {
    "name": "Witcher: With Flickering Heart",
    "slug": "vn-app",
    "version": "5.0.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dimagdd.vnapp"
    },
    "android": {
      "package": "com.dimagdd.vnapp",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#09090b"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "experiments": {
      "baseUrl": "/vn-app"
    },
    "extra": {
      "eas": {
        "projectId": "679cb1cb-4ade-4ad7-bc60-60c43e115293"
      }
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/cinzel/Cinzel_700Bold.ttf",
            "./node_modules/@expo-google-fonts/montserrat/Montserrat_400Regular.ttf",
            "./node_modules/@expo-google-fonts/montserrat/Montserrat_600SemiBold.ttf"
          ]
        }
      ]
    ]
  }
}
